<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Pocket Dungeon</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#cfc4a4">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="apple-touch-icon" href="icon-192.png">
<style>
:root{--bg:#cfc4a4;--key:#b9ad8c;--ink:#2e2c27;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#26241f;--key:#3b382f;--ink:#cfc4a4}}
:root[data-theme="dark"]{--bg:#26241f;--key:#3b382f;--ink:#cfc4a4}
html,body{height:100%;margin:0;background:var(--bg);overflow:hidden;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}
body{display:flex;flex-direction:column;align-items:center;justify-content:space-between;font-family:"Courier New",monospace}
canvas{width:min(100vw,54vh);aspect-ratio:1;image-rendering:pixelated;display:block;margin-top:6px}
#pad{display:flex;justify-content:space-between;align-items:center;width:min(100vw,420px);padding:8px 18px 14px;box-sizing:border-box}
.dp{display:grid;grid-template-columns:repeat(3,58px);grid-template-rows:repeat(3,58px);gap:2px}
.b{background:var(--key);border:3px solid var(--ink);border-radius:6px;color:var(--ink);font:bold 22px "Courier New",monospace;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 0 var(--ink)}
.b.on{transform:translateY(3px);box-shadow:0 1px 0 var(--ink)}
#A{width:84px;height:84px;border-radius:50%;font-size:26px}
</style></head><body>
<canvas id="c" width="160" height="160"></canvas>
<div id="pad">
<div class="dp">
<span></span><div class="b" data-k="u">▲</div><span></span>
<div class="b" data-k="l">◀</div><span></span><div class="b" data-k="r">▶</div>
<span></span><div class="b" data-k="d">▼</div><span></span>
</div>
<div class="b" id="A">A</div>
</div>
<script>
const P=['#d1c5a5','#a79d83','#6b6657','#2e2c27'];
const cv=document.getElementById('c'),g=cv.getContext('2d');
const T=16,HUD=16;
const SP={
 p:['..2222..','.223322.','.233332.','..2332..','.222222.','2.2222.2','..2..2..','.33..33.'],
 o:['..3333..','.322223.','32122123','32222223','32122123','32211223','.322223.','..3333..'],
 g:['..3333..','.321123.','32112223','32222223','.322223.','..3223..','...33...','........'],
 l:['..3..3..','.323323.','32223223','32233223','.322223.','..3223..','...33...','........'],
 k:['..3333..','.311113.','.31..13.','.311113.','..333...','...3....','...33...','...3....'],
 f:['33333333','32222223','32322323','32222223','33222233','.322223.','.332233.','..3333..'],
 h:['.33.33..','3223223.','3222223.','.32223..','..323...','...3....']
};
const LV=[
['##########','#g..l..g.#'.replace('#g..l..g.#','#g..l..g.#'),'#.##l##.##','#..ll....#','#.#.oo.#g#','#g.l...l.#','#.##.##.##','#P...g...#','##########'],
['##########','#g..D...g#','#.##.##.##','#.......k<','#.l.ooo.g#','#.#.....g#','#.#.##..##','#P......g#','##########'],
['##########','#g.l.D.l.#','#.#..#..##','>.......g#','#.#oog#.l#','#.#.l..k.<','#.#....#.#','#P.g.l.g.#','##########']
];
LV[0][0]='####E#####';LV[1][0]='####E#####';LV[2][0]='#####E####';
const LINES=['WHERE DID YOU|BRING ME, BUDDY?','FIRE STATUE! WAIT|FOR IT TO FLASH.','KEYS OPEN DOORS.|A = RETRY ROOM.'];
function spr(a,x,y,s=2){for(let r=0;r<a.length;r++)for(let c=0;c<8;c++){const ch=a[r][c];if(ch!=='.'){g.fillStyle=P[+ch];g.fillRect(x+c*s,y+r*s,s,s)}}}
const k={l:0,r:0,u:0,d:0};
let st;
function reset(){st={lvl:0,hp:3,over:0,win:0};load()}
function load(){
 const m=LV[st.lvl];st.m=m.map(r=>r.split(''));st.need=0;st.keys=0;st.got=0;st.st=[];st.fr=0;
 m.forEach((r,y)=>[...r].forEach((ch,x)=>{
  if(ch=='P'){st.p={x,y,sx:x,sy:y,rx:x*T,ry:y*T,cd:0,inv:0};st.m[y][x]='.'}
  if(ch=='g')st.need++;
  const d={'<':[-1,0],'>':[1,0]}[ch];
  if(d)st.st.push({x,y,dx:d[0],dy:d[1],o:(y*37+x*11)%60});
 }));
 st.dlg=LINES[st.lvl];
}
const tm=s=>(st.fr+s.o)%200;
function flames(){const f=new Set();for(const s of st.st)if(tm(s)>=150){let x=s.x+s.dx,y=s.y+s.dy;while('.gk'.includes(st.m[y][x])){f.add(x+','+y);x+=s.dx;y+=s.dy}}return f}
function step(dx,dy){
 const p=st.p,m=st.m,x=p.x+dx,y=p.y+dy,c=m[y][x];
 if(c=='o'){const bx=x+dx,by=y+dy;if(m[by][bx]!='.')return;m[by][bx]='o';m[y][x]='.'}
 else if(c=='l')m[y][x]='.';
 else if(c=='g'){st.got++;m[y][x]='.'}
 else if(c=='k'){st.keys++;m[y][x]='.'}
 else if(c=='D'){if(!st.keys)return;st.keys--;m[y][x]='.'}
 else if(c=='E'){if(st.got<st.need)return;if(st.lvl==2)st.win=1;else{st.lvl++;load()}return}
 else if(c!='.')return;
 p.x=x;p.y=y;
}
function upd(){
 if(st.dlg||st.over||st.win)return;
 st.fr++;const p=st.p;
 p.rx+=(p.x*T-p.rx)*.5;p.ry+=(p.y*T-p.ry)*.5;
 if(p.inv>0)p.inv--;
 if(p.cd>0)p.cd--;
 else{const dx=k.r-k.l,dy=k.d-k.u;if(dx||dy){step(dx?dx:0,dx?0:dy);p.cd=9}}
 if(!p.inv&&flames().has(p.x+','+p.y)){st.hp--;p.inv=70;p.x=p.sx;p.y=p.sy;p.rx=p.x*T;p.ry=p.y*T;if(st.hp<=0)st.over=1}
}
function txt(t,x,y,c=3,al='left'){g.fillStyle=P[c];g.textAlign=al;g.textBaseline='top';g.font='bold 8px "Courier New",monospace';g.fillText(t,x,y)}
function box(x,y,w,h){g.fillStyle=P[3];g.fillRect(x,y,w,h);g.fillStyle=P[0];g.fillRect(x+2,y+2,w-4,h-4)}
function draw(){
 g.fillStyle=P[0];g.fillRect(0,0,160,160);
 spr(SP.g,2,4,1);txt(st.got+'/'+st.need,12,4);
 spr(SP.k,132,4,1);txt('x'+st.keys,142,4);
 for(let i=0;i<3;i++){const a=SP.h;for(let r=0;r<6;r++)for(let c=0;c<7;c++){const ch=a[r][c];if(ch!=='.'){g.fillStyle=i<st.hp?P[+ch]:P[1];if(i>=st.hp&&ch=='3')g.fillStyle=P[2];g.fillRect(58+i*10+c,5+r,1,1)}}}
 g.save();g.translate(0,HUD);
 const fl=flames();
 for(let ty=0;ty<9;ty++)for(let tx=0;tx<10;tx++){
  const x=tx*T,y=ty*T,c=st.m[ty][tx];
  if(c=='#'){
   g.fillStyle=P[2];g.fillRect(x,y,T,T);g.fillStyle=P[3];g.fillRect(x,y+7,T,2);g.fillRect(x,y+15,T,1);g.fillRect(x+((ty+tx)%2?4:10),y,2,8);g.fillRect(x+((ty+tx)%2?10:4),y+8,2,8);
   g.fillStyle=P[1];g.fillRect(x,y,T,1);continue;
  }
  if(c=='E'){
   if(st.got<st.need){g.fillStyle=P[3];g.fillRect(x,y,T,T);g.fillStyle=P[2];for(let i=2;i<16;i+=4)g.fillRect(x+i,y,2,T)}
   else{g.fillStyle=P[1];g.fillRect(x,y,T,T);g.fillStyle=P[3];g.fillRect(x+3,y+2,10,14);g.fillStyle=P[0];g.fillRect(x+6,y+(st.fr>>3&1?9:11),4,3)}
   continue;
  }
  if(c=='D'){g.fillStyle=P[3];g.fillRect(x,y,T,T);g.fillStyle=P[2];g.fillRect(x+2,y+2,12,12);g.fillStyle=P[0];g.fillRect(x+7,y+5,2,3);g.fillRect(x+6,y+8,4,4);continue}
  if((tx*7+ty*13)%9==0){g.fillStyle=P[1];g.fillRect(x+6,y+8,2,2)}
  if(fl.has(tx+','+ty)){g.fillStyle=P[(st.fr>>2)&1?2:1];g.fillRect(x,y+3,T,10);g.fillStyle=P[(st.fr>>1)&1?3:0];g.fillRect(x+2,y+6,12,4)}
  if(c=='<'||c=='>'){const s=st.st.find(q=>q.x==tx&&q.y==ty),t=tm(s);if(t>=110&&t<150&&(st.fr>>2)&1){g.fillStyle=P[1];g.fillRect(x,y,T,T)}spr(SP.f,x,y)}
  else if(SP[c]&&'olgk'.includes(c))spr(SP[c],x,y);
 }
 const p=st.p;
 g.fillStyle=P[1];g.fillRect(p.rx+3,p.ry+14,10,2);
 if(!(p.inv&&p.inv%8<4))spr(SP.p,p.rx,p.ry);
 g.restore();
 if(st.dlg){
  box(4,104,152,52);spr(SP.p,118,112,4);
  const l=st.dlg.split('|');txt(l[0],12,114);txt(l[1],12,126);
  if(Date.now()%800
